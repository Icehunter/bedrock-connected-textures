{
  "format_version": 1,
  "max_permutations": 4096,
  "carrier_fallback": [
    {
      "blocks": [
        "minecraft:infested_*"
      ],
      "reason": "Infested blocks release silverfish when broken or blown up. These rules stay on entity carriers."
    },
    {
      "blocks": [
        "minecraft:chiseled_bookshelf"
      ],
      "reason": "Chiseled bookshelves hold books and show them per slot. These rules stay on entity carriers."
    }
  ],
  "behaviors": [
    {
      "blocks": [
        "minecraft:*_log",
        "minecraft:*_wood",
        "minecraft:crimson_stem",
        "minecraft:warped_stem",
        "minecraft:stripped_*_stem",
        "minecraft:*_hyphae"
      ],
      "leaf_guard": {
        "radius": 6,
        "leaves": [
          "minecraft:*_leaves",
          "minecraft:azalea_leaves_flowered"
        ]
      },
      "cost": 8,
      "reason": "Leaves only check for logs while update_bit is set, and a block change next to them sets it. Logs stay vanilla while a nearby leaf has a check pending; after a swap, update_bit is cleared again on leaves that had it clear before. An axe strips a replaced log (bct:strip) like vanilla.",
      "strip": true
    }
  ],
  "panes": {
    "blocks": [
      "minecraft:glass_pane",
      "minecraft:*_stained_glass_pane",
      "minecraft:iron_bars"
    ],
    "connect": [
      "minecraft:*glass_pane",
      "minecraft:*_bars",
      "minecraft:*_wall",
      "minecraft:glass",
      "minecraft:*_stained_glass",
      "minecraft:tinted_glass"
    ],
    "reason": "Panes and bars connect to other panes and bars, walls and full blocks; the engine reads the vanilla connection states on swap-in and works them out again when a neighbor changes."
  },
